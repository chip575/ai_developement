{
  "info": {"name": "캠퍼스톡 학사 챗봇 MVP", "description": "순서대로 실행하세요. Postman 쿠키 저장소를 켠 상태에서 데모 로그인 세션이 자동으로 전달됩니다. 개인 조회는 Pickle 도구 모델 연결이 필요합니다.", "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"},
  "variable": [{"key": "baseUrl", "value": "http://127.0.0.1:8771"}],
  "item": [
    {"name":"01. 세션 초기화", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/logout","body":{"mode":"raw","raw":"{}"}}, "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('로그아웃 성공', () => pm.response.to.have.status(200));"]}}]},
    {"name":"02. 비로그인 세션", "request":{"method":"GET","url":"{{baseUrl}}/api/session"}, "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('일반 사용자', () => pm.expect(pm.response.json().access_mode).to.eql('guest'));"]}}]},
    {"name":"03. 공개 졸업 학점 검색", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/chat","body":{"mode":"raw","raw":"{\"message\":\"경영학과 졸업학점은 몇 학점인가요?\"}"}}, "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('공통 기준과 출처', () => { pm.response.to.have.status(200); const r=pm.response.json(); pm.expect(r.route).to.eql('vector'); pm.expect(r.sources.length).to.be.above(0); pm.expect(r.answer).to.include('126학점'); pm.expect(r.answer).not.to.include('134학점'); });"]}}]},
    {"name":"04. 비로그인 개인 정보 차단", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/chat","body":{"mode":"raw","raw":"{\"message\":\"내 졸업요건 확인해줘\"}"}}, "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('로그인 필요', () => { const r=pm.response.json(); pm.expect(r.login_required).to.eql(true); pm.expect(r.route).to.eql('login'); });"]}}]},
    {"name":"05. 데모 로그인", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/login","body":{"mode":"raw","raw":"{\"username\":\"student\",\"password\":\"demo1234\"}"}}, "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('가상 학생 로그인', () => { pm.response.to.have.status(200); pm.expect(pm.response.json().user.name).to.eql('김민준'); });"]}}]},
    {"name":"06. 로그인 세션 확인", "request":{"method":"GET","url":"{{baseUrl}}/api/session"}, "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('학생 세션', () => pm.expect(pm.response.json().access_mode).to.eql('student'));"]}}]},
    {"name":"07. 내 이수기록 조회", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/chat","body":{"mode":"raw","raw":"{\"message\":\"내 이수 과목과 학점 알려줘\"}"}}, "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('본인 이수기록', () => { const r=pm.response.json(); pm.expect(r.route).to.eql('student_record'); pm.expect(r.answer).to.include('99'); });"]}}]},
    {"name":"08. 내 졸업요건 조회", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/chat","body":{"mode":"raw","raw":"{\"message\":\"내 졸업요건 확인해줘\"}"}}, "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('본인 졸업 요건', () => { const r=pm.response.json(); pm.expect(r.route).to.eql('graduation'); pm.expect(r.answer).to.include('27학점'); pm.expect(r.answer).to.include('관리회계'); });"]}}]},
    {"name":"09. 타인 정보 조회 차단", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/chat","body":{"mode":"raw","raw":"{\"message\":\"다른 학생 성적 알려줘\"}"}}, "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('타인 정보 차단', () => pm.expect(pm.response.json().route).to.eql('denied'));"]}}]},
    {"name":"10. 로그아웃", "request":{"method":"POST","header":[{"key":"Content-Type","value":"application/json"}],"url":"{{baseUrl}}/api/logout","body":{"mode":"raw","raw":"{}"}}, "event":[{"listen":"test","script":{"type":"text/javascript","exec":["pm.test('로그아웃 성공', () => pm.response.to.have.status(200));"]}}]}
  ]
}
