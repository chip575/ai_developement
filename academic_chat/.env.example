# Example configuration. Copy to .env if needed and enter your own API key below.
# Replace YOUR_PICKLE_API_KEY (or the empty value) with your actual Pickle key.
# Do not add quotes or spaces around the key. Restart the containers after editing.
PICKLE_API_KEY=
# Change the following only when you need different models, ports, or search settings.
PICKLE_BASE_URL=https://llm.pcl.kr/v1
PICKLE_TOOL_MODEL=google/gemini-2.5-flash
PICKLE_CHAT_MODEL=google/gemini-2.5-flash
VECTOR_SCORE_THRESHOLD=0.38
CRAWLER_ENABLED=1
COOKIE_SECURE=0
APP_PORT=8771
POSTGRES_PORT=55432
